# Bright Data Scraper Studio (required)
BRIGHTDATA_API_KEY=your_key_here

# One collector ID per scraper — valid JSON on ONE line (13 small single-page collectors)
# BRIGHTDATA_SCRAPERS={"wikipedia_ai":"c_xxx","tiangolo":"c_xxx","react":"c_xxx","python_docs":"c_xxx","openai":"c_xxx","devpost":"c_xxx","github_readme":"c_xxx","mdn_web":"c_xxx","docker_intro":"c_xxx","stripe_docs":"c_xxx","wiki_javascript":"c_xxx","anthropic_news":"c_xxx","sqlite_docs":"c_xxx"}
BRIGHTDATA_SCRAPERS={}

# Groq (Console RAG answers) — free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
# Production free-tier default (best stable quality on Groq free):
GROQ_MODEL=openai/gpt-oss-120b
# Faster/cheaper alternative: openai/gpt-oss-20b
# GROQ_MAX_TOKENS=768

# Auto-heal when extraction quality is below these (optional)
# HEAL_MIN_SUCCESS_RATE=60
# HEAL_MAX_EMPTY_FIELD_PCT=40
