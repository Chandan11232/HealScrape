# Bright Data Scraper Studio (required)
BRIGHTDATA_API_KEY=your_key_here

# One collector ID per scraper — valid JSON on ONE line
# Primary collectors for this app:
# BRIGHTDATA_SCRAPERS={"wikipedia_ai": "c_xxx", "weather": "c_yyy"}
BRIGHTDATA_SCRAPERS={}

# Supplementary scrapers (optional free tiers)
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Auto-heal when extraction quality is below these (optional)
# HEAL_MIN_SUCCESS_RATE=60
# HEAL_MAX_EMPTY_FIELD_PCT=40
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
